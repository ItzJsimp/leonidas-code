{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/Session-Start.ps1; exit 0",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File scripts/Hook-PushCompleteSignal.ps1",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python -S \"$CLAUDE_PROJECT_DIR/.claude/hooks/laya-gate.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
